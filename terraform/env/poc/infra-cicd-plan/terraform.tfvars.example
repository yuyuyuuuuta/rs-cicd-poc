aws_account_id             = "<AWS_ACCOUNT_ID>"
aws_region                 = "<AWS_REGION>"
github_repository          = "<OWNER>/<REPOSITORY>"
github_repository_owner_id = "<GITHUB_OWNER_ID>"
github_repository_id       = "<GITHUB_REPOSITORY_ID>"
name_prefix                = "<RESOURCE_NAME_PREFIX>"
state_bucket_name          = "<TF_STATE_BUCKET>"
artifact_bucket_name       = "<PLAN_ARTIFACT_BUCKET>"
test_bucket_name           = "<TF_TEST_BUCKET>"
codeconnections_arn        = "<CODECONNECTIONS_ARN>"
source_artifact_bucket_name = "<ARTIFACT_BUCKET>"
github_app_secret_arn       = "<GITHUB_APP_SECRET_ARN>"

# Optional. Set only when the secret uses a customer-managed KMS key.
# github_app_secret_kms_key_arn = "<KMS_KEY_ARN>"

# Optional per-root bucket overrides; omitted roots use test_bucket_name.
# target_bucket_names = {
#   "ci-test" = "<TF_TEST_BUCKET>"
# }